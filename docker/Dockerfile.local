# STEP1: BUILD BACKEND (from local source)
FROM golang:1.26-trixie AS builder_backend
WORKDIR /home/filestash/
COPY . .
RUN apt-get update > /dev/null && \
    apt-get install -y curl make > /dev/null 2>&1 && \
    apt-get install -y libjpeg-dev libtiff-dev libpng-dev libwebp-dev libraw-dev libheif-dev libgif-dev libvips-dev > /dev/null 2>&1

RUN make init && \
    make build && \
    mkdir -p ./dist/data/state/config/ && \
    cp config/config.json ./dist/data/state/config/config.json

# STEP2: BUILD PROD IMAGE
FROM registry.access.redhat.com/ubi9-minimal:latest

WORKDIR /app

# Runtime deps for the MINIMIZED plugin set (passthrough + local + s3 + starter_http):
# the Go binary only links brotli (verified via `ldd /app/filestash`) and needs
# ca-certificates for TLS trust. Image-processing libs (libjpeg/png/tiff/webp/heif/vips)
# and libsharpyuv are intentionally omitted — they are not linked by this build, so
# installing them would only add unused, CVE-bearing packages. curl/libcurl are removed
# for the same reason (the binary uses Go net/http, not libcurl).
# NOTE: if image plugins (plg_image_*, plg_video_transcoder) are re-enabled, restore the
# EPEL repo + libjpeg-turbo/libpng/libtiff/libwebp/libheif + libsharpyuv here.
RUN set -eux; \
    microdnf -y update; \
    rpm -e --nodeps libarchive 2>/dev/null || true; \
    microdnf -y install ca-certificates shadow-utils brotli; \
    microdnf -y clean all; \
    rpm -e --nodeps curl-minimal libcurl-minimal 2>/dev/null || true

COPY --from=builder_backend /home/filestash/dist/ .

RUN useradd -u 1001 filestash; \
    mkdir -p /app/data; \
    chown -R filestash:filestash /app; \
    chgrp -R 0 /app; chmod -R g+rwX /app; \
    find /app/data -type d -exec chmod 770 {} \; || true; \
    find /app/data -type f -exec chmod 760 {} \; || true; \
    chmod 730 /app/filestash

USER 1001:0
EXPOSE 8334
CMD ["/app/filestash"]
